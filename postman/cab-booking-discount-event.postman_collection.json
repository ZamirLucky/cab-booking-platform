{
  "info": {
    "name": "Cab Booking - Discount Event Test",
    "description": "Verifies the booking.completed event discount logic end-to-end.\nRegisters a fresh user, completes 4 booking cycles, and asserts:\n  - A discount notification is created after the 3rd completed booking.\n  - No second discount notification appears after the 4th completed booking.\nRun via scripts/run-booking-newman-tests.ps1 (Stage 4) or manually with Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Setup",
      "description": "Register a fresh test user and login. A unique email is generated per run so the collection is self-contained.",
      "item": [
        {
          "name": "00a — Register test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique email per run so discount state is always fresh.",
                  "const ts = Date.now();",
                  "pm.environment.set('discountTestEmail',    'discounttest+' + ts + '@example.com');",
                  "pm.environment.set('discountTestPassword', 'Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 — user registered', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/api/customers/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Discount\",\n  \"surname\": \"Tester\",\n  \"email\": \"{{discountTestEmail}}\",\n  \"password\": \"{{discountTestPassword}}\"\n}"
            }
          }
        },
        {
          "name": "00b — Login and save token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response has token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.test('Response has userId', () => pm.expect(json.userId).to.be.a('string').and.not.empty);",
                  "",
                  "pm.environment.set('token',  json.token);",
                  "pm.environment.set('userId', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/api/customers/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{discountTestEmail}}\",\n  \"password\": \"{{discountTestPassword}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "01 Booking 1 Cycle",
      "description": "Create a booking and immediately patch it to completed. Completed count: 1 — no discount fires.",
      "item": [
        {
          "name": "01a — Create Booking 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response has id', () => pm.expect(json.id).to.be.a('string').and.not.empty);",
                  "",
                  "pm.environment.set('disBookingId1', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{gatewayUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_location\": \"Valletta\",\n  \"end_location\": \"Sliema\",\n  \"booking_datetime\": \"2026-06-01T10:00:00.000Z\",\n  \"passengers\": 1,\n  \"cab_type\": \"Economic\"\n}"
            }
          }
        },
        {
          "name": "01b — PATCH Booking 1 to completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Status is completed', () => pm.expect(json.status).to.equal('completed'));",
                  "console.log('[discount] Booking 1 completed. Count so far: 1 (no discount yet).');"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/bookings/{{disBookingId1}}/status",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "bookings", "{{disBookingId1}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        }
      ]
    },
