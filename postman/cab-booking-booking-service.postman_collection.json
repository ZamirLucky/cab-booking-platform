                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Create booking returns 201', () => pm.response.to.have.status(201));",
                  "const bookingId = json.bookingId || json.id || (json.booking && json.booking.id);",
                  "pm.test('Booking ID exists', () => pm.expect(bookingId).to.exist);",
                  "pm.environment.set('bookingId', bookingId);",
                  "console.log('Created bookingId:', bookingId);"
                ]
