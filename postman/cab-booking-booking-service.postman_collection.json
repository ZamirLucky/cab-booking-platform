              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Booking health returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Booking service is ok', () => pm.expect(json.status).to.eql('ok'));",
                  "console.log('Booking health:', JSON.stringify(json));"
