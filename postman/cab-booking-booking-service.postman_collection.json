{
  "info": {
    "name": "Cab Booking - Booking Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Setup - Register and Login via Gateway",
      "item": [
        {
          "name": "00a - Register Test User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'bookingtest+' + Date.now() + '@example.com';",
                  "pm.environment.set('testEmail', email);",
                  "console.log('Registering with email:', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201', () => pm.response.to.have.status(201));",
                  "console.log('Register response:', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Booking\",\n  \"surname\": \"Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/customers/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "register"
              ]
            }
          }
        },
        {
          "name": "00b - Login and Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token exists', () => pm.expect(json.token).to.exist);",
                  "pm.environment.set('token', json.token);",
                  "pm.environment.set('userId', json.userId);",
                  "console.log('Logged in userId:', json.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/customers/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "login"
              ]
            }
          }
        }
      ]
    },
