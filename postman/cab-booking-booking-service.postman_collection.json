        {
          "name": "06 - View Current Bookings",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/bookings/current",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "current"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const bookings = json.bookings || json;",
                  "pm.test('Current bookings returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Current bookings is an array', () => pm.expect(bookings).to.be.an('array'));",
                  "pm.test('Created booking is visible in current bookings', () => { const found = bookings.some(b => b.id === pm.environment.get('bookingId')); pm.expect(found).to.eql(true); });",
                  "console.log('Current booking count:', bookings.length);"
                ]
              }
            }
          ]
        },
