{
  "info": {
    "name": "Cab Booking Location — Service Down",
    "description": "Service-down test for location-service.\nConfirms the gateway returns 503 when location-service is unreachable.\nPrerequisite: run the normal-flow collection first (token must be set in the environment),\nthen STOP location-service before running this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Service Down",
      "description": "Stop location-service before running these requests.",
      "item": [
        {
          "name": "Add location via gateway — service down, expect 503",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 503', () => pm.response.to.have.status(503));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response has error property', () => pm.expect(json).to.have.property('error'));",
                  "pm.test('Error indicates unavailability', () =>",
                  "  pm.expect(json.error.toLowerCase()).to.include('unavailable')",
                  ");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{gatewayUrl}}/api/locations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Test\",\n  \"address\": \"Valletta, Malta\"\n}"
            }
          }
        }
      ]
    }
  ]
}
