{
  "info": {
    "name": "Cab Booking Platform",
    "description": "Local integration tests for the Cab Booking Platform microservices. Phase 3 adds Gateway testing at port 4000. Use environment 'Cab Booking Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Customer Service (direct port 3001)",
      "description": "Tests against Customer Service directly. Use {{baseUrl}} = http://localhost:3001. For phase 3 onwards, prefer testing via the Gateway.",
      "item": [
        {
          "name": "01 - Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "02 - Register Valid User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"surname\": \"User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Register returns 201', function () { pm.response.to.have.status(201); });",
                  "if (json.userId) { pm.environment.set('userId', json.userId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Register Duplicate User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"surname\": \"User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          }
        },
        {
          "name": "04 - Register Short Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Short\",\n  \"surname\": \"Password\",\n  \"email\": \"shortpass@example.com\",\n  \"password\": \"1234\"\n}"
            }
          }
        },
        {
          "name": "05 - Login Valid User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token exists', function () { pm.expect(json.token).to.exist; });",
                  "pm.environment.set('token', json.token);",
                  "pm.environment.set('userId', json.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Login Wrong Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "07 - Account Without Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/account"
          }
        },
        {
          "name": "08 - Account With Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/account",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "09 - Get Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "10 - Create Notification Internal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notifications",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"type\": \"system\",\n  \"title\": \"Test Notification\",\n  \"message\": \"Hello from Postman Step 2 test\",\n  \"payload\": { \"source\": \"postman\", \"reason\": \"Step 2 test\" }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Notification created 201', function () { pm.response.to.have.status(201); });",
                  "if (json.notificationId) { pm.environment.set('notificationId', json.notificationId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Get Notifications After Create",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.notifications && json.notifications.length > 0) {",
                  "  pm.environment.set('notificationId', json.notifications[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Mark Notification As Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "02 - Gateway — Customer Routes (port 4000)",
      "description": "Integration tests via the Gateway. Use {{gatewayUrl}} = http://localhost:4000. Both Customer Service (3001) and Gateway (4000) must be running.",
      "item": [
        {
          "name": "01 - Gateway Health Check",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway health returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Service name is gateway-service', function () { pm.expect(json.service).to.equal('gateway-service'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Register via Gateway",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/api/customers/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Gateway\",\n  \"surname\": \"Test\",\n  \"email\": \"gatewaytest001@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register via Gateway returns 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.userId) { pm.environment.set('userId', json.userId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Login via Gateway",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/api/customers/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gatewaytest001@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login via Gateway returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Token exists', function () { pm.expect(json.token).to.exist; });",
                  "pm.environment.set('token', json.token);",
                  "pm.environment.set('userId', json.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Account Without Token (Gateway rejects)",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/customers/account"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('No token returns 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error message present', function () { pm.expect(pm.response.json().error).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Account With Token via Gateway",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/customers/account",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Account returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('password_hash not in response', function () { pm.expect(json.password_hash).to.be.undefined; });",
                  "pm.test('id present', function () { pm.expect(json.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Notifications via Gateway",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/customers/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Notifications returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.notifications && json.notifications.length > 0) {",
                  "  pm.environment.set('notificationId', json.notifications[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Mark Notification Read via Gateway",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/api/customers/notifications/{{notificationId}}/read",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mark read returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Service Down Test",
          "description": "Stop Customer Service before running this. Gateway must return 503, not crash.",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/customers/account",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Service down returns 503', function () { pm.response.to.have.status(503); });",
                  "const json = pm.response.json();",
                  "pm.test('Error message is service unavailable', function () {",
                  "  pm.expect(json.error).to.equal('Service temporarily unavailable');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
